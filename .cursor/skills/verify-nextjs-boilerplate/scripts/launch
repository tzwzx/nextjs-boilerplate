#!/usr/bin/env bash
# Start an isolated Next.js Boilerplate instance for verification.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/common.sh"

if [[ -f ${INSTANCE_FILE} ]]; then
  # shellcheck disable=SC1090
  source "${INSTANCE_FILE}"
  if pid_alive "${VERIFY_PID:-}"; then
    echo "launch: already running pid=${VERIFY_PID} at ${VERIFY_URL}" >&2
    echo "launch: refuse to start a second instance in this checkout (shared .next)." >&2
    exit 1
  fi
  echo "launch: removing stale instance file for dead pid ${VERIFY_PID:-unknown}" >&2
  rm -f "${INSTANCE_FILE}"
fi

foreign=$(checkout_server_pids || true)
if [[ -n ${foreign} ]]; then
  echo "launch: this checkout already has a listening process (pids: ${foreign//$'\n'/ })." >&2
  echo "launch: refuse to share .next with that server. Stop it, or verify from another worktree." >&2
  exit 1
fi

if [[ -n $(port_listen_pids "${VERIFY_PORT}") ]]; then
  echo "launch: port ${VERIFY_PORT} is already in use by pids: $(port_listen_pids "${VERIFY_PORT}" | tr '\n' ' ')" >&2
  echo "launch: set VERIFY_PORT to a free port, or free ${VERIFY_PORT}." >&2
  exit 1
fi

mkdir -p "${RUN_DIR}" "${EVIDENCE_DIR}"
: >"${SERVER_LOG}"

cd "${REPO_ROOT}"
# nohup so the server survives the launching shell (SIGHUP would kill a bare `&`).
nohup bun run dev -- --port "${VERIFY_PORT}" --hostname "${VERIFY_HOST}" >>"${SERVER_LOG}" 2>&1 < /dev/null &
pid=$!
write_instance "${pid}"

if ! wait_for_ready_log 60; then
  echo "launch: no Ready/Local line in ${SERVER_LOG} within 30s" >&2
  echo "launch: last 40 lines of ${SERVER_LOG}:" >&2
  tail -n 40 "${SERVER_LOG}" >&2 || true
  kill_tree "${pid}"
  wait "${pid}" 2>/dev/null || true
  rm -f "${INSTANCE_FILE}"
  exit 1
fi

if ! wait_for_home "${VERIFY_URL}" 30; then
  echo "launch: server did not serve the home heading at ${VERIFY_URL}/ after becoming ready" >&2
  echo "launch: last 40 lines of ${SERVER_LOG}:" >&2
  tail -n 40 "${SERVER_LOG}" >&2 || true
  kill_tree "${pid}"
  wait "${pid}" 2>/dev/null || true
  rm -f "${INSTANCE_FILE}"
  exit 1
fi

echo "VERIFY_URL=${VERIFY_URL}"
echo "VERIFY_PID=${pid}"
echo "VERIFY_LOG=${SERVER_LOG}"
echo "INSTANCE_FILE=${INSTANCE_FILE}"
echo "EVIDENCE_DIR=${EVIDENCE_DIR}"
echo "launch: holding pid ${pid} so the server stays up; stop with scripts/cleanup"

# Stay attached. Cursor (and similar) sandboxes reap descendants when this
# command exits, even under nohup. Run launch in a long-lived background shell.
wait "${pid}"
status=$?
echo "launch: server pid ${pid} exited ${status}"
exit "${status}"
